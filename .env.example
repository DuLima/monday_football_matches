# Copy this file to .env.local and fill in the values from the Firebase console.
# For production (GitHub Pages), also create .env.production with the same values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The Google account allowed to edit. Comparison is case-insensitive.
VITE_OWNER_EMAIL=duarte.lima@pst.asseco.com
